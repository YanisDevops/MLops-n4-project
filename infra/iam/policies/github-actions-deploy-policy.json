{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"EcrLogin","Effect":"Allow","Action":"ecr:GetAuthorizationToken","Resource":"*"},
    {
      "Sid":"PushPredictorImage","Effect":"Allow",
      "Action":["ecr:DescribeRepositories","ecr:BatchCheckLayerAvailability","ecr:CompleteLayerUpload","ecr:GetDownloadUrlForLayer","ecr:InitiateLayerUpload","ecr:PutImage","ecr:UploadLayerPart"],
      "Resource":"arn:aws:ecr:us-east-1:AWS_ACCOUNT_ID:repository/mlops-n4-predictor"
    },
    {"Sid":"ReadEksCluster","Effect":"Allow","Action":"eks:DescribeCluster","Resource":"arn:aws:eks:us-east-1:AWS_ACCOUNT_ID:cluster/mlops-n4"}
  ]
}