{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListArtifactsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::MLFLOW_BUCKET_PLACEHOLDER"
    },
    {
      "Sid": "ManageArtifactObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::MLFLOW_BUCKET_PLACEHOLDER/*"
    }
  ]
}
